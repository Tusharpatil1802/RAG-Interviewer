# App runs without OPENAI_API_KEY using deterministic fallback logic.
# Add a key for LLM profile extraction, question generation, answer evaluation, and final narrative summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./interview.db
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
KB_DIR=./data/kb_docs
MAX_TURNS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
